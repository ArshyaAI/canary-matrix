+def _safe_archive_name(raw_name):
+    normalized = str(raw_name).replace("\\", "/")
+    while normalized.startswith("./"):
+        normalized = normalized[2:]
+    if not normalized:
+        return ""
+    if normalized.startswith("/"):
+        raise RuntimeError(f"unsafe workspace archive path: {raw_name!r}")
+    path = PurePosixPath(normalized)
+    if path.is_absolute() or any(part in {"", ".", ".."} for part in path.parts):
+        raise RuntimeError(f"unsafe workspace archive path: {raw_name!r}")
+    return path.as_posix()
+
+
+def _fixture_entries(workdir):
+    if not os.path.isdir(workdir) or os.path.islink(workdir):
+        raise RuntimeError("secure fixture root must be a real directory")
+    entries = []
+    total_bytes = 0
+    for root, dirs, files in os.walk(workdir, topdown=True, followlinks=False):
+        dirs.sort()
+        files.sort()
+        for name in dirs + files:
+            absolute = os.path.join(root, name)
+            relative = _safe_archive_name(os.path.relpath(absolute, workdir))
+            st = os.lstat(absolute)
+            if statlib.S_ISLNK(st.st_mode):
+                raise RuntimeError(f"secure fixture rejects symlink: {relative}")
+            if not (statlib.S_ISDIR(st.st_mode) or statlib.S_ISREG(st.st_mode)):
+                raise RuntimeError(f"secure fixture rejects special file: {relative}")
+            if statlib.S_ISREG(st.st_mode):
+                if st.st_size > _SECURE_FIXTURE_MAX_FILE_BYTES:
+                    raise RuntimeError(f"secure fixture file limit exceeded: {relative}")
+                total_bytes += st.st_size
+                if total_bytes > _SECURE_FIXTURE_MAX_BYTES:
+                    raise RuntimeError("secure fixture total byte limit exceeded")
+            entries.append((relative, absolute, st))
+            if len(entries) > _SECURE_FIXTURE_MAX_ENTRIES:
+                raise RuntimeError("secure fixture entry limit exceeded")
+    return entries
+
+
+def _write_fixture_tar(workdir, archive):
+    with tarfile.open(fileobj=archive, mode="w|") as bundle:
+        for relative, absolute, st in _fixture_entries(workdir):
+            info = tarfile.TarInfo(relative + ("/" if statlib.S_ISDIR(st.st_mode) else ""))
+            info.uid = 0
+            info.gid = 0
+            info.uname = ""
+            info.gname = ""
+            info.mtime = 0
+            info.mode = statlib.S_IMODE(st.st_mode) & 0o777
+            if statlib.S_ISDIR(st.st_mode):
+                info.type = tarfile.DIRTYPE
+                info.size = 0
+                bundle.addfile(info)
+            else:
+                info.type = tarfile.REGTYPE
+                info.size = st.st_size
+                with open(absolute, "rb") as source:
+                    bundle.addfile(info, source)
+
