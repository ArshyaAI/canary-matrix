+def _stage_workspace_into_volume(workdir, volume, image, container_workdir="/work"):
+    with tempfile.TemporaryFile() as archive:
+        _write_fixture_tar(workdir, archive)
+        archive.seek(0)
+        cmd = [
+            "docker", "run", "--rm", "-i",
+            "--read-only", "--network", "none", "--cap-drop", "ALL",
+            "--security-opt", "no-new-privileges",
+            "--mount", f"type=volume,src={volume},dst={container_workdir}",
+            image, "tar", "-C", container_workdir, "-xf", "-",
+        ]
+        proc = subprocess.run(
+            cmd, stdin=archive, capture_output=True, timeout=60)
+    if proc.returncode != 0:
+        detail = (proc.stderr or proc.stdout or b"unknown error")[-2000:].decode(
+            "utf-8", errors="replace")
+        raise RuntimeError(f"secure fixture copy-in failed: {detail}")
+
+
+def _extract_workspace_archive(archive, destination, max_total_bytes):
+    total_bytes = 0
+    entries = 0
+    seen = set()
+    with tarfile.open(fileobj=archive, mode="r:*") as bundle:
+        for member in bundle:
+            relative = _safe_archive_name(member.name)
+            if not relative:
+                continue
+            entries += 1
+            if entries > _SECURE_COPYOUT_MAX_ENTRIES:
+                raise RuntimeError("secure copy-out entry limit exceeded")
+            if relative in seen:
+                raise RuntimeError(f"secure copy-out duplicate path: {relative}")
+            seen.add(relative)
+            if not (member.isdir() or member.isfile()):
+                raise RuntimeError(f"secure copy-out rejects non-regular entry: {relative}")
+            target = os.path.realpath(os.path.join(destination, *PurePosixPath(relative).parts))
+            if os.path.commonpath((os.path.realpath(destination), target)) != os.path.realpath(destination):
+                raise RuntimeError(f"secure copy-out path escaped root: {relative}")
+            if member.isdir():
+                os.makedirs(target, mode=0o700, exist_ok=True)
+                continue
+            if member.size > _SECURE_COPYOUT_MAX_FILE_BYTES:
+                raise RuntimeError(f"secure copy-out file limit exceeded: {relative}")
+            total_bytes += member.size
+            if total_bytes > max_total_bytes:
+                raise RuntimeError("secure copy-out total byte limit exceeded")
+            os.makedirs(os.path.dirname(target), mode=0o700, exist_ok=True)
+            source = bundle.extractfile(member)
+            if source is None:
+                raise RuntimeError(f"secure copy-out cannot read: {relative}")
+            flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0)
+            fd = os.open(target, flags, 0o600)
+            written = 0
+            try:
+                with os.fdopen(fd, "wb", closefd=False) as output:
+                    while True:
+                        chunk = source.read(64 * 1024)
+                        if not chunk:
+                            break
+                        written += len(chunk)
+                        if written > member.size:
+                            raise RuntimeError(f"secure copy-out size mismatch: {relative}")
+                        output.write(chunk)
+            finally:
+                os.close(fd)
+                source.close()
+            if written != member.size:
+                raise RuntimeError(f"secure copy-out size mismatch: {relative}")
+            os.chmod(target, member.mode & 0o777)
+
+
+def _replace_workspace_contents(workdir, staged):
+    if not os.path.isdir(workdir) or os.path.islink(workdir):
+        raise RuntimeError("secure copy-out target must be a real directory")
+    for name in os.listdir(workdir):
+        path = os.path.join(workdir, name)
+        if os.path.isdir(path) and not os.path.islink(path):
+            shutil.rmtree(path)
+        else:
+            os.unlink(path)
+    shutil.copytree(staged, workdir, dirs_exist_ok=True, symlinks=False)
+
+
+def _copy_workspace_from_volume(
+        workdir, volume, image, container_workdir="/work",
+        max_total_bytes=_SECURE_WORK_VOLUME_BYTES):
+    parent = os.path.dirname(os.path.abspath(workdir))
+    staged = tempfile.mkdtemp(prefix="openbench_canary_copyout_", dir=parent)
+    try:
+        with tempfile.TemporaryFile() as archive:
+            cmd = [
+                "docker", "run", "--rm",
+                "--read-only", "--network", "none", "--cap-drop", "ALL",
+                "--security-opt", "no-new-privileges",
+                "--mount", f"type=volume,src={volume},dst={container_workdir},readonly",
+                image, "tar", "-C", container_workdir, "-cf", "-", ".",
+            ]
+            proc = subprocess.run(
+                cmd, stdout=archive, stderr=subprocess.PIPE, timeout=60)
+            if proc.returncode != 0:
+                detail = (proc.stderr or b"unknown error")[-2000:].decode(
+                    "utf-8", errors="replace")
+                raise RuntimeError(f"secure workspace copy-out failed: {detail}")
+            archive_bytes = archive.tell()
+            if archive_bytes > max_total_bytes + 2 * 1024 * 1024:
+                raise RuntimeError("secure copy-out archive limit exceeded")
+            archive.seek(0)
+            _extract_workspace_archive(archive, staged, max_total_bytes)
+        _replace_workspace_contents(workdir, staged)
+    finally:
+        shutil.rmtree(staged, ignore_errors=True)
+
