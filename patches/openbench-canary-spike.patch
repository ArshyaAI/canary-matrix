+class _BoundedStreamCapture:
+    """Drain one pipe while retaining bounded evidence and a full-stream digest."""
+
+    def __init__(self, *, stream_limit_bytes, line_limit_bytes, exceeded_event,
+                 head_bytes=_OUTPUT_HEAD_BYTES, tail_bytes=_OUTPUT_TAIL_BYTES):
+        self.stream_limit_bytes = stream_limit_bytes
+        self.line_limit_bytes = line_limit_bytes
+        self.exceeded_event = exceeded_event
+        self.head_bytes = head_bytes
+        self.tail_bytes = tail_bytes
+        self.total_bytes = 0
+        self.current_line_bytes = 0
+        self.head = bytearray()
+        self.tail = bytearray()
+        self.digest = hashlib.sha256()
+        self.limit_reason = None
+
+    def _trip(self, reason):
+        if self.limit_reason is None:
+            self.limit_reason = reason
+            self.exceeded_event.set()
+
+    def feed(self, chunk):
+        if not chunk:
+            return
+        self.total_bytes += len(chunk)
+        self.digest.update(chunk)
+
+        remaining_head = max(0, self.head_bytes - len(self.head))
+        if remaining_head:
+            self.head.extend(chunk[:remaining_head])
+        remainder = chunk[remaining_head:]
+        if remainder and self.tail_bytes:
+            self.tail.extend(remainder)
+            if len(self.tail) > self.tail_bytes:
+                del self.tail[:-self.tail_bytes]
+
+        segments = chunk.split(b"\n")
+        if len(segments) == 1:
+            self.current_line_bytes += len(chunk)
+            longest = self.current_line_bytes
+        else:
+            longest = max(
+                self.current_line_bytes + len(segments[0]),
+                *(len(part) for part in segments[1:]),
+            )
+            self.current_line_bytes = len(segments[-1])
+        if longest > self.line_limit_bytes:
+            self._trip("line_limit")
+        if self.total_bytes > self.stream_limit_bytes:
+            self._trip("stream_limit")
+
+    @property
+    def truncated(self):
+        return self.total_bytes > len(self.head) + len(self.tail)
+
+    def text(self):
+        marker = b"\n[... bounded capture omitted bytes ...]\n" if self.truncated else b""
+        return (bytes(self.head) + marker + bytes(self.tail)).decode(
+            "utf-8", errors="replace")
+
+    def sha256(self):
+        return self.digest.hexdigest()
+
+
+def _drain_pipe(pipe, capture):
+    try:
+        while True:
+            chunk = pipe.read(64 * 1024)
+            if not chunk:
+                break
+            capture.feed(chunk)
+    finally:
+        try:
+            pipe.close()
+        except OSError:
+            pass
