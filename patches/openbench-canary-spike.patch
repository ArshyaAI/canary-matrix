+def _create_bounded_work_volume(name, size_bytes=_SECURE_WORK_VOLUME_BYTES):
+    if not _SECURE_VOLUME_RE.fullmatch(name):
+        raise ValueError("invalid secure work volume name")
+    if not isinstance(size_bytes, int) or size_bytes <= 0:
+        raise ValueError("secure work volume size must be a positive integer")
+    cmd = [
+        "docker", "volume", "create",
+        "--driver", "local",
+        "--opt", "type=tmpfs",
+        "--opt", "device=tmpfs",
+        "--opt", f"o=size={size_bytes},nosuid,nodev,noexec",
+        "--label", "openbench.canary=true",
+        name,
+    ]
+    proc = subprocess.run(cmd, capture_output=True, text=True, timeout=30)
+    if proc.returncode != 0 or (proc.stdout or "").strip() != name:
+        detail = (proc.stderr or proc.stdout or "unknown error").strip()
+        raise DockerUnavailable(
+            f"cannot create bounded secure work volume {name!r}: {detail}")
+    return name
+
+
+def _force_remove_volume(name, attempts=3, delay_s=2):
+    for attempt in range(attempts):
+        try:
+            subprocess.run(
+                ["docker", "volume", "rm", "-f", name],
+                capture_output=True, text=True, timeout=30,
+            )
+            probe = subprocess.run(
+                ["docker", "volume", "inspect", name],
+                capture_output=True, text=True, timeout=20,
+            )
+            if probe.returncode != 0:
+                return True
+        except (FileNotFoundError, subprocess.TimeoutExpired):
+            pass
+        if attempt < attempts - 1:
+            time.sleep(delay_s)
+    return False
+
