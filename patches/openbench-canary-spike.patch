+def _new_work_volume_name(harness):
+    safe = re.sub(r"[^A-Za-z0-9_.-]", "_", str(harness or "cell"))[:32]
+    return f"openbench_canary_{safe}_{os.getpid()}_{uuid.uuid4().hex[:8]}"
